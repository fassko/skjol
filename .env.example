# --- Arkiv (Rabdi testnet) ---
ARKIV_ACCESS_KEY=
ARKIV_APP_PRIVATE_KEY=
ARKIV_OBSERVER_PRIVATE_KEY=
ARKIV_SYNC_PRIVATE_KEY=
STORE_BACKEND=arkiv

# --- App secrets ---
SKJOL_MASTER_KEY=
SESSION_SECRET=

# --- Swarm (required for demo / prize submission) ---
# gateway: public Swarm gateway stamps uploads server-side (prize-ready without a client batch).
# bee: requires SWARM_POSTAGE_BATCH_ID from your funded Bee node.
# local-dev: skips Swarm (not for judges).
SWARM_MODE=gateway
SWARM_API_URL=https://api.gateway.ethswarm.org
# Optional on gateway; required for SWARM_MODE=bee
SWARM_POSTAGE_BATCH_ID=
# If you set a batch, document the buyer/supplier wallet in arkiv/swarm.md

# --- Chain (Arc testnet by default) ---
CHAIN_MODE=arc-testnet
