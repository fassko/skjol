# Raw 64-hex private key WITHOUT 0x (CRE CLI requirement). Must equal the pool's simulationOperator
# when using the MockKeystoneForwarder on Arc Testnet. Never commit the real .env.
CRE_ETH_PRIVATE_KEY=
# VesselFinder API key (secret VESSELFINDER_API_KEY in secrets.yaml). Only needed for live
# evaluation of Indian ports; Finnish ports use Digitraffic, which needs no key.
VESSELFINDER_API_KEY_VAR=
